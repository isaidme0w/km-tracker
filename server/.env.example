# Server runtime configuration
NODE_ENV=development

# HTTP port the Express server listens on
PORT=3001

# SQLite database file location (relative to the server/ directory)
DB_PATH=./data/km-tracker.sqlite

# JWT signing secret (must be changed in production)
JWT_SECRET=change-me-in-production

# JWT token lifetime (e.g. 1h, 1d, 7d)
JWT_EXPIRES_IN=7d

# Allowed CORS origin (Vite dev server)
CORS_ORIGIN=http://localhost:5173